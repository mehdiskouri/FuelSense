FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements/forecaster-cpu.txt /tmp/requirements/forecaster-cpu.txt
RUN pip install --no-cache-dir -r /tmp/requirements/forecaster-cpu.txt

COPY forecaster /app/forecaster
COPY fuelsense_common /app/fuelsense_common

EXPOSE 8001
CMD ["uvicorn", "forecaster.service:app", "--host", "0.0.0.0", "--port", "8001"]
