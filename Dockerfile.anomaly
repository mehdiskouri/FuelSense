FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements/anomaly.txt /tmp/requirements/anomaly.txt
RUN pip install --no-cache-dir -r /tmp/requirements/anomaly.txt

COPY anomaly /app/anomaly
COPY fuelsense_common /app/fuelsense_common

EXPOSE 8002
CMD ["uvicorn", "anomaly.service:app", "--host", "0.0.0.0", "--port", "8002"]
