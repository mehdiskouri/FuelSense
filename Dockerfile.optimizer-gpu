FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/optimizer-gpu.txt /tmp/requirements/optimizer-gpu.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements/optimizer-gpu.txt

COPY optimizer /app/optimizer
COPY fuelsense_common /app/fuelsense_common

EXPOSE 8003
CMD ["python3", "-m", "uvicorn", "optimizer.service:app", "--host", "0.0.0.0", "--port", "8003"]
