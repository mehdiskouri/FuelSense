FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements/optimizer-cpu.txt /tmp/requirements/optimizer-cpu.txt
RUN pip install --no-cache-dir -r /tmp/requirements/optimizer-cpu.txt

COPY optimizer /app/optimizer
COPY fuelsense_common /app/fuelsense_common

EXPOSE 8003
CMD ["uvicorn", "optimizer.service:app", "--host", "0.0.0.0", "--port", "8003"]
